   "source": [
    "import pandas as pd \n",
    "#create a sample data\n",
    "data={'gender':['male','female','female','male','male'],\n",
    "      'Handedness':['right handed','left handed','right handed','right handed','right handed']}\n",
    "df=pd.DataFrame(data)\n",
    "\n",
    "#creating cross tabulation \n",
    "crosstab=pd.crosstab(df['gender'],df['Handedness'])\n",
    "print(crosstab)\n",
    "#it takes 2 column from the dataframe df:gender and handedness ,this function count the occurence \n",
    "#this table shows the count of each combination of gender and handedness "
   ]
